{
    "name": "ggermanboldyrev/laravel-schema-file",
    "description": "One always up-to-date file with your whole Laravel database schema, regenerated after every migration. Inspired by Rails' schema.rb.",
    "keywords": [
        "laravel",
        "schema",
        "migrations",
        "database",
        "schema.rb",
        "rails"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/GGermanBoldyrev/laravel-schema-file",
    "authors": [
        {
            "name": "German Boldyrev",
            "email": "germanefbasd@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "GGermanBoldyrev\\SchemaFile\\": "src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "GGermanBoldyrev\\SchemaFile\\SchemaFileServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
